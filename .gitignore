# Public docs contain source Markdown and explicit configuration examples only.
# Historical reports/data remain available in the local workspace.
/docs/*
!/docs/*.md
!/docs/examples/
/docs/examples/*
!/docs/examples/*.json
!/docs/release-validation.json
